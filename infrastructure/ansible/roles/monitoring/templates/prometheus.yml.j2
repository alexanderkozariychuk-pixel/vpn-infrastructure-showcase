global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'node-exporter-bulgaria'
    static_configs:
      - targets: ['node-exporter:9100']
        labels:
          node: 'bulgaria'

  - job_name: 'node-exporter-moldova'
    static_configs:
      - targets: ['{{ moldova_entry_ip }}:9100']
        labels:
          node: 'moldova'