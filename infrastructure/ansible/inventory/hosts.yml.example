# Copy to hosts.yml (git-ignored) and fill in. Addresses and public keys
# live here, private keys in the vault file outside the repository.
all:
  vars:
    # Workstation key for the admin user (public half).
    admin_ssh_pubkey: "ssh-ed25519 AAAA... alexander@pop-os"
    # sov-monitor on am1 reaches sov-probe as `sovmon` from this address only.
    monitor_from: "<am1-address>"
    sovmon_ssh_pubkey: "ssh-ed25519 AAAA... sov-monitor@am1"

  children:
    entry:
      vars:
        # The portal reaches the wrappers as `pwa-provisioner` from here only.
        entry_portal_from: "<portal-address>"
        entry_pwa_provisioner_pubkey: "ssh-ed25519 AAAA... pwa-provisioner@portal"
        # awg0's public key, the one every client config carries. Same on
        # every entry; checked against the running interface.
        entry_awg0_public_key: "<awg0 public key, 44 chars>"
      # Entry A is deliberately not here. It carries paying clients and is
      # changed by hand; it is compared with B by tools/node-inventory.sh,
      # not by Ansible.
      hosts:
        entry-b:
          # An alias from ~/.ssh/config (HostName, IdentityFile live there).
          ansible_host: sov-entry-b
          # First run with -e ansible_user=root, before sovadmin exists.
          ansible_user: sovadmin
          admin_user: sovadmin
          # entry_link is filled in at stage 3, when the exit gets awg2.

    # Hosts that carry paying clients. playbooks/entry.yml refuses to run
    # against these except with --check. A second fence: no live host
    # belongs in this inventory in the first place.
    live:
      hosts: {}
