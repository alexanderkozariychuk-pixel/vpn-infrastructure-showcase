# ─── Database ─────────────────────────────────────────────────────────
# Host is the compose service name, NOT localhost.
# NOTE: keep the password hex/alnum — a raw '/', '@', '+' or ':' breaks URL parsing.
DATABASE_URL=postgresql+asyncpg://sre_user:CHANGE_ME@postgres:5432/vpn_sre
POSTGRES_PASSWORD=CHANGE_ME

# ─── Secrets (no defaults — the app refuses to start without them) ────
# JWT_SECRET:  openssl rand -hex 32
# FERNET_KEY:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#              (must be a valid Fernet key — 32 url-safe base64 bytes, NOT openssl rand)
JWT_SECRET=
FERNET_KEY=

# ─── Admin account ────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ─── Foreign exit node (status / logs / backbone health are read here) ─
EXIT_IP=
EXIT_USER=sovadmin
AWG_INTERFACE=awg0
# Far end of the backbone /30, as seen from the exit node
BACKBONE_PEER_IP=10.77.77.2

# ─── VPN entry node the PWA provisions peers on ───────────────────────
BRIDGE_IP=
BRIDGE_USER=vpnadmin
BRIDGE_AWG_INTERFACE=awg0
BRIDGE_PUBLIC_KEY=
BRIDGE_ENDPOINT=

# ─── Public URLs (go into payment callbacks and reset emails) ─────────
# MUST be the real https:// domain — http:// or a bare IP breaks both.
SITE_URL=https://your-domain.example
PORTAL_BASE_URL=https://your-domain.example

# ─── Heleket billing ──────────────────────────────────────────────────
HELEKET_MERCHANT_ID=
HELEKET_API_KEY=

# ─── Mail ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SUPPORT_INBOX=

# ─── LLM assistant ────────────────────────────────────────────────────
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-2.0-flash-001
