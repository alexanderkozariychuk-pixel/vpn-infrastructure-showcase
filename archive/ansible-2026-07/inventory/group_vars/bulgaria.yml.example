# infrastructure/ansible/group_vars/bulgaria.yml.example
# Copy to bulgaria.yml and fill in values

# Common
new_user: vpnadmin
ssh_public_key: "{{ lookup('file', '~/.ssh/id_ed25519.pub') }}"

# UFW
ufw_allowed_ports:
  - "22/tcp"
  - "443/tcp"

# Xray Exit Node
xray_inbound_port: 443
xray_log_level: warning
xray_dest: "www.microsoft.com:443"
xray_server_name: "www.microsoft.com"
xray_fingerprint: chrome
xray_short_id: "6ba85179e30d4fc2"

# Monitoring
monitoring_dir: /opt/monitoring
grafana_port: 3000
prometheus_port: 9090
loki_port: 3100
grafana_admin_password: "your_strong_password_here"
prometheus_retention: "30d"

# Moldova Entry IP (for Prometheus scraping)
moldova_entry_ip: "OLD_MOLDOVA_IP"