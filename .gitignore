# =============================================
# Terraform
# =============================================
**/terraform.tfvars
**/*.tfvars
**/.terraform/
**/terraform.tfstate*
**/terraform.tfstate.backup
**/.terraform.lock.hcl

# Yandex Cloud specific (covered by patterns above, but keep for clarity)
infrastructure/terraform/yandex/terraform.tfvars

# Aeza specific (covered by patterns above, but keep for clarity)
infrastructure/terraform/aeza/terraform.tfvars

# =============================================
# Python & Virtual Environments
# =============================================
venv/
venv-*/
.env
*.env
.python-version
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# =============================================
# IDE and Editor files
# =============================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# =============================================
# Logs and temporary files
# =============================================
*.log
logs/
tmp/
temp/

# =============================================
# Monitoring and sensitive configs
# =============================================
monitoring/**/grafana-dashboard.json
configs/**/3x-ui-settings.txt
configs/**/*.conf
!configs/**/*.example

# =============================================
# Secrets and credentials
# =============================================
*.key
*.pem
*.p12
*.pfx
secrets/
credentials/

# =============================================
# Miscellaneous
# =============================================
*.bak
*.bak[0-9]
*.bak-*
*.backup
*.tmp

# =============================================
#Terraform Backend
# =============================================
infrastructure/yc-backend-setup/
sa-key.json

# =============================================
#Infrastructure 
infrastructure/ansible/inventory/hosts.ini

# Real inventory vars hold private keys and PSKs. Only *.example is tracked.
# Two parallel group_vars/ dirs exist (inventory/group_vars and group_vars) —
# match on the directory name, not the full path, so neither can slip through.
**/group_vars/*.yml
!**/group_vars/*.yml.example
# =============================================

# Bot archives
monitoring/ai-bot-monitoring/*.tar.gz

# Docker scripts
monitoring/get-docker.sh

# Old/experimental playbooks
infrastructure/ansible/playbooks/deploy-shadowsocks.yml
infrastructure/ansible/playbooks/deploy-tun2socks.yml
infrastructure/ansible/playbooks/deploy-backbone.yml

# Roles from abandoned experiments
infrastructure/ansible/roles/outline/
infrastructure/ansible/roles/fou-backbone/

# Bot archives
monitoring/ai-bot-monitoring/*.tar.gz
monitoring/get-docker.sh

# Experimental/abandoned playbooks and roles
infrastructure/ansible/playbooks/deploy-shadowsocks.yml
infrastructure/ansible/playbooks/deploy-tun2socks.yml
infrastructure/ansible/playbooks/deploy-backbone.yml
infrastructure/ansible/roles/outline/
infrastructure/ansible/roles/fou-backbone/

