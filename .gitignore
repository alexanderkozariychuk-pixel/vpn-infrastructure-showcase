# =============================================
# Terraform
# =============================================
infrastructure/terraform/**/terraform.tfvars
infrastructure/terraform/**/*.tfvars
infrastructure/terraform/**/.terraform/
infrastructure/terraform/**/terraform.tfstate*
infrastructure/terraform/**/terraform.tfstate.backup
infrastructure/terraform/**/.terraform.lock.hcl

# Yandex Cloud specific
infrastructure/terraform/yandex/terraform.tfvars

# =============================================
# Python & Virtual Environments
# =============================================
venv/
venv-*/
.env
*.env
.python-version
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# =============================================
# IDE and Editor files
# =============================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# =============================================
# Logs and temporary files
# =============================================
*.log
logs/
tmp/
temp/

# =============================================
# Monitoring and sensitive configs
# =============================================
monitoring/**/grafana-dashboard.json
configs/**/3x-ui-settings.txt
configs/**/*.conf
!configs/**/*.example

# =============================================
# Secrets and credentials
# =============================================
*.key
*.pem
*.p12
*.pfx
secrets/
credentials/

# =============================================
# Miscellaneous
# =============================================
*.bak
*.backup
*.tmp

