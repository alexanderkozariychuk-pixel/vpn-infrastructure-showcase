#!/usr/bin/env bash
# Stand-in for `awg` in the infrastructure tests. Peers live in $AWG_STATE as
# "<pubkey> <allowed-ips> [<psk> [<latest handshake> [<keepalive>]]]" lines. Covers exactly the calls the wrappers and the
# trial scripts make; anything else fails loudly.
set -euo pipefail
state="${AWG_STATE:?AWG_STATE not set}"
touch "$state"
case "$1 ${3:-}" in
    "show peers")       awk '{ print $1 }' "$state" ;;
    "show allowed-ips") awk '{ printf "%s\t%s\n", $1, $2 }' "$state" ;;
    "show ")            awk '{ printf "peer: %s\n  allowed ips: %s\n", $1, $2 }' "$state" ;;
    "show dump")
        printf 'PRIVATE\tPUBLIC\t8443\toff\n'
        awk '{ printf "%s\t%s\t(none)\t%s\t%s\t0\t0\t%s\n", $1, ($3 != "" ? $3 : "(none)"), $2,
                      ($4 != "" ? $4 : 0), ($5 != "" ? $5 : "off") }' "$state" ;;
    "set peer")
        key="$4"
        if [[ "${5:-}" == remove ]]; then
            grep -vF -- "$key " "$state" > "$state.tmp" || true
            mv "$state.tmp" "$state"
        else
            [[ -z "${AWG_FAIL_SET:-}" ]] || { echo "fake awg: set refused" >&2; exit 1; }
            [[ "$5" == preshared-key && "$7" == allowed-ips ]] || exit 9
            echo "$key $8 $(cat "$6") 0 ${10:-off}" >> "$state"
        fi ;;
    *) echo "fake awg: unsupported: $*" >&2; exit 9 ;;
esac
